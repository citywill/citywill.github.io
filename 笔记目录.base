filters:
  and:
    - file.folder == "posts"
formulas:
  年月: datetime.format("YYYY-MM")
views:
  - type: cards
    name: 卡片
    filters:
      and:
        - file.inFolder("posts")
    groupBy:
      property: formula.年月
      direction: DESC
    order:
      - title
      - datetime
      - category
      - file.tags
    sort:
      - property: datetime
        direction: DESC
    columnSize:
      file.name: 285
      note.datetime: 168
      note.title: 306
    image: note.image
    imageAspectRatio: 0.6
